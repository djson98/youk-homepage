---
import { siteConfig } from '../config/site.config';
import Seo from '../components/Seo.astro';
import NavBar from '../components/islands/NavBar.tsx';
import SearchOverlay from '../components/islands/SearchOverlay.tsx';
import '../styles/global.css';

export interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const { title, description, image } = Astro.props;

// Map nav hrefs to section keys for toggling.
const sectionByHref: Record<string, keyof typeof siteConfig.sections> = {
  '/': 'home',
  '/about': 'about',
  '/research': 'research',
  '/members': 'members',
  '/projects': 'projects',
  '/publications': 'publications',
  '/lectures': 'lectures',
  '/gallery': 'gallery',
  '/news': 'news',
  '/contact': 'contact',
};

const navItems = siteConfig.nav.items
  .filter((item) => {
    const sectionKey = sectionByHref[item.href];
    if (!sectionKey) return true;
    return siteConfig.sections[sectionKey];
  })
  .map((item) => ({ href: item.href, label: item.labelEn }));

const activePath = Astro.url.pathname;
const hasHero = Astro.slots.has('hero');
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <Seo
      title={title}
      description={description}
      image={image}
      pathname={activePath}
    />
    <script is:inline>
      // Apply persisted theme before paint to avoid a flash.
      try {
        const saved = localStorage.getItem('theme');
        const prefersDark =
          window.matchMedia &&
          window.matchMedia('(prefers-color-scheme: dark)').matches;
        if (saved === 'dark' || (!saved && prefersDark)) {
          document.documentElement.classList.add('dark');
        }
      } catch {
        /* noop */
      }
    </script>
  </head>
  <body
    class="bg-page text-primary flex min-h-screen flex-col transition-colors duration-300"
  >
    <NavBar
      client:load
      brandName={siteConfig.lab.nameKo}
      brandHref="/"
      items={navItems}
      activePath={activePath}
    />
    <SearchOverlay client:idle />

    <slot name="hero" />

    <main
      class:list={[
        'text-primary mx-auto w-full max-w-7xl flex-1 px-3 pb-16 md:px-8',
        hasHero ? 'pt-10' : 'pt-20 md:pt-24',
      ]}
      id="main-content"
      role="main"
    >
      <slot />
    </main>

    <footer
      class="bg-surface border-default mt-auto border-t py-6 transition-colors duration-300"
    >
      <div class="mx-auto w-full max-w-7xl px-3 md:px-8">
        <div class="flex items-center justify-between gap-4">
          <div class="text-muted-subtle text-xs md:text-sm">
            <div class="max-w-2xl">
              {
                siteConfig.contact.address && (
                  <div class="text-muted-subtle mb-1 text-xs whitespace-pre-line md:mb-2">
                    {siteConfig.contact.address}
                  </div>
                )
              }
              <span class="text-muted-subtle block text-xs">
                © {new Date().getFullYear()}
                {siteConfig.lab.nameKo} ·
                <a
                  href={`mailto:${siteConfig.professor.email}`}
                  class="hover:text-accent"
                >
                  {siteConfig.professor.email}
                </a>
              </span>
            </div>
          </div>
        </div>
      </div>
    </footer>
  </body>
</html>
