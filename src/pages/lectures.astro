---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getLectures } from '../lib/sanity';

const sorted = await getLectures();
---

<BaseLayout title="강의">
  <h1 class="page-title mb-6">강의</h1>

  {
    sorted.length === 0 ? (
      <p class="text-muted">준비 중입니다.</p>
    ) : (
      <div class="space-y-10">
        {sorted.map((entry) => (
          <article class="border-b border-default pb-8">
            <header class="mb-4">
              <p class="text-sm text-muted">{entry.data.semester}</p>
              <h2 class="text-xl font-semibold text-primary mt-1">
                {entry.data.courseName}
              </h2>
              {entry.data.courseType && (
                <p class="text-sm text-muted mt-1">{entry.data.courseType}</p>
              )}
              {entry.data.description && (
                <p class="mt-3 leading-relaxed whitespace-pre-line">
                  {entry.data.description}
                </p>
              )}
              <dl class="mt-3 text-sm text-muted grid grid-cols-1 sm:grid-cols-2 gap-x-6 gap-y-1">
                {entry.data.credits != null && (
                  <div>
                    <dt class="inline font-medium text-primary">학점:</dt>{' '}
                    <dd class="inline">{entry.data.credits}</dd>
                  </div>
                )}
                {entry.data.schedule && (
                  <div>
                    <dt class="inline font-medium text-primary">시간:</dt>{' '}
                    <dd class="inline">{entry.data.schedule}</dd>
                  </div>
                )}
                {entry.data.room && (
                  <div>
                    <dt class="inline font-medium text-primary">강의실:</dt>{' '}
                    <dd class="inline">{entry.data.room}</dd>
                  </div>
                )}
                {entry.data.syllabus && (
                  <div>
                    <dt class="inline font-medium text-primary">강의계획서:</dt>{' '}
                    <dd class="inline">
                      <a
                        href={entry.data.syllabus}
                        target="_blank"
                        rel="noopener"
                        class="underline"
                      >
                        PDF 다운로드
                      </a>
                    </dd>
                  </div>
                )}
              </dl>
            </header>
          </article>
        ))}
      </div>
    )
  }
</BaseLayout>
