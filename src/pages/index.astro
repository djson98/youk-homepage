---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroSection from '../components/HeroSection.astro';
import RecentPublications from '../components/RecentPublications.astro';
import RecentNews from '../components/RecentNews.astro';
import { siteConfig } from '../config/site.config';
---

<BaseLayout>
  <HeroSection slot="hero" />

  <section class="space-y-2">
    <h1 class="text-2xl font-bold text-primary">
      {siteConfig.professor.nameKo}
    </h1>
    <p class="text-muted">{siteConfig.professor.affiliation}</p>
    {
      siteConfig.lab.tagline && (
        <p class="italic text-muted">{siteConfig.lab.tagline}</p>
      )
    }
  </section>

  {
    siteConfig.lab.keywords.length > 0 && (
      <section class="mt-6">
        <h2 class="text-lg font-semibold mb-2 text-primary">연구 키워드</h2>
        <ul class="flex flex-wrap gap-2">
          {siteConfig.lab.keywords.map((kw) => (
            <li class="px-2 py-1 bg-surface-muted rounded text-sm text-primary">
              {kw}
            </li>
          ))}
        </ul>
      </section>
    )
  }

  <div class="mt-12 space-y-12">
    <RecentPublications limit={5} />
    <RecentNews limit={4} />
  </div>
</BaseLayout>
