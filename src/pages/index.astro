---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroSection from '../components/HeroSection.astro';
import { siteConfig } from '../config/site.config';

const sectionLinks = siteConfig.nav.items.filter((item) => {
  if (item.href === '/') return false;
  const map: Record<string, keyof typeof siteConfig.sections> = {
    '/about': 'about',
    '/members': 'members',
    '/projects': 'projects',
    '/publications': 'publications',
    '/lectures': 'lectures',
    '/gallery': 'gallery',
    '/contact': 'contact',
  };
  const key = map[item.href];
  return key ? siteConfig.sections[key] : true;
});
---

<BaseLayout>
  <HeroSection slot="hero" />

  <section class="space-y-2">
    <h1 class="text-2xl font-bold">{siteConfig.professor.nameKo}</h1>
    <p class="text-gray-700">{siteConfig.professor.affiliation}</p>
    {
      siteConfig.lab.tagline && (
        <p class="italic text-gray-600">{siteConfig.lab.tagline}</p>
      )
    }
  </section>

  {
    siteConfig.lab.keywords.length > 0 && (
      <section class="mt-6">
        <h2 class="text-lg font-semibold mb-2">연구 키워드</h2>
        <ul class="flex flex-wrap gap-2">
          {siteConfig.lab.keywords.map((kw) => (
            <li class="px-2 py-1 bg-gray-100 rounded text-sm">{kw}</li>
          ))}
        </ul>
      </section>
    )
  }

  <section class="mt-8">
    <h2 class="text-lg font-semibold mb-2">섹션</h2>
    <ul class="list-disc pl-5 space-y-1">
      {
        sectionLinks.map((item) => (
          <li>
            <a href={item.href} class="text-blue-700 hover:underline">
              {item.labelKo}
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</BaseLayout>
