---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getMembers } from '../lib/sanity';
import { siteConfig } from '../config/site.config';

const POSITION_LABEL: Record<string, string> = {
  professor: '교수',
  postdoc: '박사후연구원',
  phd: '박사과정',
  ms: '석사과정',
  undergrad: '학부생',
  alumni: '졸업생',
};

const POSITION_ORDER: Record<string, number> = {
  professor: 0,
  postdoc: 1,
  phd: 2,
  ms: 3,
  undergrad: 4,
  alumni: 5,
};

const all = await getMembers();
const sorted = [...all].sort((a, b) => {
  const oa = POSITION_ORDER[a.data.position] ?? 99;
  const ob = POSITION_ORDER[b.data.position] ?? 99;
  if (oa !== ob) return oa - ob;
  return (a.data.order ?? 99) - (b.data.order ?? 99);
});

const groups = new Map<string, typeof sorted>();
for (const m of sorted) {
  const key = m.data.position;
  if (!groups.has(key)) groups.set(key, [] as typeof sorted);
  groups.get(key)!.push(m);
}

// 교수 카드는 Sanity를 우선하고, Sanity에 교수 문서가 없으면
// src/content/members/professor.md로 폴백한다. 지금 Sanity에는 교수 문서가
// 없어서 교수 섹션(관심 분야 포함)이 통째로 빠져 있었다.
const professorFromSanity = sorted.find((m) => m.data.position === 'professor');
const professorMd = (await getCollection('members')).find(
  (e) => e.data.position === 'professor'
);
const professorEntry = professorFromSanity ?? professorMd;

// 학력·전문 분야 같은 상세 소개는 professor.md 본문에 있다.
// 본문을 렌더할 때는 frontmatter의 bio(같은 내용의 요약)를 중복 노출하지 않는다.
const ProfessorBody = professorMd ? (await render(professorMd)).Content : null;
---

<BaseLayout title="구성원">
  <h1 class="page-title mb-8">구성원</h1>

  {
    professorEntry && (
      <section class="mb-14">
        <h2 class="text-muted mb-4 text-xs font-semibold tracking-widest uppercase">
          {POSITION_LABEL.professor}
        </h2>

        <div class="border-default bg-surface rounded-xl border p-5 md:p-7">
          <div class="flex flex-col gap-6 sm:flex-row sm:gap-8">
            {professorEntry.data.photo && (
              <img
                src={professorEntry.data.photo}
                alt={professorEntry.data.nameKo ?? professorEntry.data.name}
                class="border-default h-56 w-44 flex-shrink-0 self-start rounded-lg border object-cover"
              />
            )}

            <div class="min-w-0 flex-1">
              <p class="text-primary font-display text-2xl leading-tight font-semibold">
                {professorEntry.data.nameKo ?? professorEntry.data.name}
              </p>
              <p class="text-muted mt-1 text-sm">
                {professorEntry.data.nameKo && (
                  <span>{professorEntry.data.name} · </span>
                )}
                {siteConfig.professor.title} ·{' '}
                {siteConfig.professor.affiliation}
              </p>

              {professorEntry.data.researchFields &&
                professorEntry.data.researchFields.length > 0 && (
                  <ul class="mt-4 flex flex-wrap gap-1.5">
                    {professorEntry.data.researchFields.map((f) => (
                      <li class="btn-badge">{f}</li>
                    ))}
                  </ul>
                )}

              <div class="mt-4 flex flex-wrap items-center gap-x-4 gap-y-2 text-sm">
                {professorEntry.data.email && (
                  <a
                    href={`mailto:${professorEntry.data.email}`}
                    class="text-muted hover:text-primary underline decoration-1 underline-offset-2"
                  >
                    {professorEntry.data.email}
                  </a>
                )}
                {professorEntry.data.homepage && (
                  <a
                    href={professorEntry.data.homepage}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="text-muted hover:text-primary underline decoration-1 underline-offset-2"
                  >
                    KNUH 프로필 ↗
                  </a>
                )}
                {siteConfig.lab.github && (
                  <a
                    href={siteConfig.lab.github}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="text-muted hover:text-primary underline decoration-1 underline-offset-2"
                  >
                    GitHub ↗
                  </a>
                )}
              </div>
            </div>
          </div>

          {ProfessorBody ? (
            <div class="md-prose border-default mt-6 border-t pt-6">
              <ProfessorBody />
            </div>
          ) : (
            professorEntry.data.bio && (
              <p class="text-muted border-default mt-6 border-t pt-6 text-sm leading-relaxed whitespace-pre-line">
                {professorEntry.data.bio}
              </p>
            )
          )}
        </div>
      </section>
    )
  }

  {
    Array.from(groups.entries())
      .filter(([pos]) => pos !== 'professor')
      .map(([pos, members]) => (
        <section class="mb-12">
          <h2 class="text-muted mb-4 text-xs font-semibold tracking-widest uppercase">
            {POSITION_LABEL[pos] ?? pos}
          </h2>
          <ul class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
            {members.map((m) => (
              <li class="border-default bg-surface hover:border-accent-hover flex flex-col rounded-xl border p-4 transition-colors">
                <div class="flex gap-4">
                  {m.data.photo ? (
                    <img
                      src={m.data.photo}
                      alt={m.data.nameKo ?? m.data.name}
                      class="h-24 w-20 flex-shrink-0 rounded-lg object-cover"
                    />
                  ) : (
                    <div
                      class="bg-surface-muted text-muted-subtle flex h-24 w-20 flex-shrink-0 items-center justify-center rounded-lg text-xs"
                      aria-hidden="true"
                    >
                      사진 없음
                    </div>
                  )}

                  <div class="min-w-0 flex-1">
                    <p class="text-primary truncate font-medium">
                      {m.data.nameKo ?? m.data.name}
                    </p>
                    {m.data.nameKo && m.data.name !== m.data.nameKo && (
                      <p class="text-muted-subtle truncate text-xs">
                        {m.data.name}
                      </p>
                    )}

                    {/* 비어 있는 항목은 '—'로 채우지 않고 줄 자체를 뺀다. */}
                    {m.data.researchFields &&
                      m.data.researchFields.length > 0 && (
                        <ul class="mt-2 flex flex-wrap gap-1">
                          {m.data.researchFields.map((f) => (
                            <li class="btn-badge">{f}</li>
                          ))}
                        </ul>
                      )}

                    {m.data.graduationInfo && (
                      <p class="text-muted-subtle mt-2 text-xs">
                        {m.data.graduationInfo}
                      </p>
                    )}

                    <div class="mt-2 space-y-0.5 text-xs">
                      {m.data.email && (
                        <a
                          href={`mailto:${m.data.email}`}
                          class="text-muted hover:text-primary block truncate underline decoration-1 underline-offset-2"
                        >
                          {m.data.email}
                        </a>
                      )}
                      {m.data.homepage && (
                        <a
                          href={m.data.homepage}
                          target="_blank"
                          rel="noopener noreferrer"
                          class="text-muted hover:text-primary block truncate underline decoration-1 underline-offset-2"
                        >
                          홈페이지 ↗
                        </a>
                      )}
                    </div>
                  </div>
                </div>

                {/* 스튜디오 '소개'란에 연구 분야를 길게 적는 경우가 많아
                    카드가 늘어지지 않게 접어둔다. */}
                {m.data.bio && (
                  <details class="border-border-muted mt-3 border-t pt-3">
                    <summary class="text-muted hover:text-primary cursor-pointer text-xs font-medium">
                      연구 분야 보기
                    </summary>
                    <p class="text-muted mt-2 text-xs leading-relaxed whitespace-pre-line">
                      {m.data.bio}
                    </p>
                  </details>
                )}
              </li>
            ))}
          </ul>
        </section>
      ))
  }
</BaseLayout>
