---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getMembers } from '../lib/sanity';

const POSITION_LABEL: Record<string, string> = {
  professor: '교수',
  postdoc: '박사후연구원',
  phd: '박사과정',
  ms: '석사과정',
  undergrad: '학부생',
  alumni: '졸업생',
};

const POSITION_ORDER: Record<string, number> = {
  professor: 0,
  postdoc: 1,
  phd: 2,
  ms: 3,
  undergrad: 4,
  alumni: 5,
};

const all = await getMembers();
const sorted = [...all].sort((a, b) => {
  const oa = POSITION_ORDER[a.data.position] ?? 99;
  const ob = POSITION_ORDER[b.data.position] ?? 99;
  if (oa !== ob) return oa - ob;
  return (a.data.order ?? 99) - (b.data.order ?? 99);
});

const groups = new Map<string, typeof sorted>();
for (const m of sorted) {
  const key = m.data.position;
  if (!groups.has(key)) groups.set(key, [] as typeof sorted);
  groups.get(key)!.push(m);
}

const professorEntry = sorted.find((m) => m.data.position === 'professor');
---

<BaseLayout title="구성원">
  <h1 class="page-title mb-8">구성원</h1>

  {
    professorEntry && (
      <section class="mb-12">
        <h2 class="text-primary mb-4 text-lg font-semibold">교수</h2>
        <div class="flex flex-col items-start gap-6 sm:flex-row">
          {professorEntry.data.photo && (
            <img
              src={professorEntry.data.photo}
              alt={professorEntry.data.nameKo ?? professorEntry.data.name}
              class="border-default h-52 w-40 flex-shrink-0 rounded border object-cover"
            />
          )}
          <div class="min-w-0 flex-1">
            <p class="text-primary text-xl font-semibold">
              {professorEntry.data.nameKo ?? professorEntry.data.name}
              {professorEntry.data.nameKo && (
                <span class="text-muted ml-2 text-base font-normal">
                  {professorEntry.data.name}
                </span>
              )}
            </p>
            {professorEntry.data.researchFields &&
              professorEntry.data.researchFields.length > 0 && (
                <p class="text-muted mt-1 text-sm">
                  {professorEntry.data.researchFields.join(' · ')}
                </p>
              )}
            <dl class="mt-3 space-y-1 text-sm">
              {professorEntry.data.email && (
                <div>
                  <dt class="text-primary inline font-medium">이메일:</dt>{' '}
                  <dd class="inline">
                    <a
                      href={`mailto:${professorEntry.data.email}`}
                      class="underline"
                    >
                      {professorEntry.data.email}
                    </a>
                  </dd>
                </div>
              )}
              {professorEntry.data.homepage && (
                <div>
                  <dt class="text-primary inline font-medium">홈페이지:</dt>{' '}
                  <dd class="inline">
                    <a
                      href={professorEntry.data.homepage}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="underline"
                    >
                      KNUH 프로필
                    </a>
                  </dd>
                </div>
              )}
            </dl>
            {professorEntry.data.bio && (
              <div class="prose prose-sm text-primary mt-4 max-w-none whitespace-pre-line">
                {professorEntry.data.bio}
              </div>
            )}
          </div>
        </div>
      </section>
    )
  }

  {
    Array.from(groups.entries())
      .filter(([pos]) => pos !== 'professor')
      .map(([pos, members]) => (
        <section class="mb-10">
          <h2 class="text-primary mb-4 text-lg font-semibold">
            {POSITION_LABEL[pos] ?? pos}
          </h2>
          <ul class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
            {members.map((m) => (
              <li class="border-default flex gap-3 rounded border p-4">
                {m.data.photo ? (
                  <img
                    src={m.data.photo}
                    alt={m.data.nameKo ?? m.data.name}
                    class="h-20 w-16 flex-shrink-0 rounded object-cover"
                  />
                ) : (
                  <div
                    class="bg-surface-muted h-20 w-16 flex-shrink-0 rounded"
                    aria-hidden="true"
                  />
                )}
                <div class="min-w-0 flex-1 space-y-1">
                  <p class="text-primary truncate font-medium">
                    {m.data.nameKo ?? m.data.name}
                  </p>
                  <p class="text-muted truncate text-xs">
                    <span class="font-medium">관심 분야:</span>{' '}
                    {m.data.researchFields && m.data.researchFields.length > 0
                      ? m.data.researchFields.join(' · ')
                      : '—'}
                  </p>
                  <p class="text-muted truncate text-xs">
                    <span class="font-medium">이메일:</span>{' '}
                    {m.data.email ? (
                      <a
                        href={`mailto:${m.data.email}`}
                        class="break-all underline"
                      >
                        {m.data.email}
                      </a>
                    ) : (
                      '—'
                    )}
                  </p>
                  <p class="text-muted truncate text-xs">
                    <span class="font-medium">홈페이지:</span>{' '}
                    {m.data.homepage ? (
                      <a
                        href={m.data.homepage}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="break-all underline"
                      >
                        링크
                      </a>
                    ) : (
                      '—'
                    )}
                  </p>
                  {/* 스튜디오 '소개'란에 연구 분야를 적는 경우가 많아 카드에도 노출한다. */}
                  {m.data.bio && (
                    <p class="text-muted pt-1 text-xs leading-relaxed whitespace-pre-line">
                      {m.data.bio}
                    </p>
                  )}
                </div>
              </li>
            ))}
          </ul>
        </section>
      ))
  }
</BaseLayout>
