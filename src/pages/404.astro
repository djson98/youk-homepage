---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="페이지를 찾을 수 없습니다">
  <section
    class="mx-auto flex max-w-2xl flex-col items-center py-24 text-center"
  >
    <p class="text-muted-subtle text-sm tracking-widest uppercase">404</p>
    <h1 class="text-primary mt-3 text-3xl font-semibold md:text-4xl">
      페이지를 찾을 수 없습니다
    </h1>
    <p class="text-muted mt-4 text-base leading-relaxed">
      주소가 잘못되었거나, 페이지가 이동·삭제되었을 수 있습니다.
    </p>
    <a
      href="/"
      class="text-accent hover:text-primary mt-8 inline-block text-sm underline"
    >
      홈으로 돌아가기
    </a>
  </section>
</BaseLayout>
