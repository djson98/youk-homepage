---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const all = await getCollection('news');
const sorted = [...all].sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime()
);

const dateFmt = new Intl.DateTimeFormat('ko-KR', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<BaseLayout title="News">
  <h1 class="page-title mb-8">News</h1>

  {
    sorted.length === 0 ? (
      <p class="text-muted">준비 중입니다.</p>
    ) : (
      <ul class="space-y-6">
        {sorted.map((n) => (
          <li class="border-b border-default pb-5">
            <p class="text-sm text-muted">{dateFmt.format(n.data.date)}</p>
            <h2 class="text-lg font-semibold text-primary mt-1">
              {n.data.link ? (
                <a
                  href={n.data.link}
                  target="_blank"
                  rel="noopener"
                  class="hover:underline"
                >
                  {n.data.title}
                </a>
              ) : (
                n.data.title
              )}
            </h2>
            {n.data.summary && (
              <p class="text-sm text-muted mt-2">{n.data.summary}</p>
            )}
            {n.data.tags && n.data.tags.length > 0 && (
              <ul class="flex flex-wrap gap-1.5 mt-3">
                {n.data.tags.map((t) => (
                  <li class="px-2 py-0.5 bg-surface-muted rounded text-xs text-muted">
                    {t}
                  </li>
                ))}
              </ul>
            )}
          </li>
        ))}
      </ul>
    )
  }
</BaseLayout>
