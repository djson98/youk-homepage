---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getNews } from '../lib/sanity';

const sorted = await getNews();

const dateFmt = new Intl.DateTimeFormat('ko-KR', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<BaseLayout title="News">
  <h1 class="page-title mb-8">News</h1>

  {
    sorted.length === 0 ? (
      <p class="text-muted">준비 중입니다.</p>
    ) : (
      <ul class="space-y-6">
        {sorted.map((n) => (
          <li class="border-default border-b pb-5">
            <p class="text-muted text-sm">{dateFmt.format(n.data.date)}</p>
            <h2 class="text-primary mt-1 text-lg font-semibold">
              {n.data.link ? (
                <a
                  href={n.data.link}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="hover:underline"
                >
                  {n.data.title}
                </a>
              ) : (
                n.data.title
              )}
            </h2>
            {n.data.summary && (
              <p class="text-muted mt-2 text-sm">{n.data.summary}</p>
            )}
            {n.data.tags && n.data.tags.length > 0 && (
              <ul class="mt-3 flex flex-wrap gap-1.5">
                {n.data.tags.map((t) => (
                  <li class="bg-surface-muted text-muted rounded px-2 py-0.5 text-xs">
                    {t}
                  </li>
                ))}
              </ul>
            )}
          </li>
        ))}
      </ul>
    )
  }
</BaseLayout>
