---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import PublicationTimeline, {
  type Publication,
} from '../components/islands/PublicationTimeline.tsx';

const pubs = await getCollection('publications');

const timelineData: Publication[] = pubs.map((entry) => ({
  id: entry.id,
  slug: entry.id,
  title: entry.data.title,
  authors: entry.data.authors,
  journal: entry.data.journal,
  year: entry.data.year,
  doi: entry.data.doi,
  type: entry.data.type,
  isPreprint: entry.data.isPreprint,
  pdf: entry.data.pdf,
}));

const sorted = [...pubs].sort((a, b) => b.data.year - a.data.year);
---

<BaseLayout title="논문">
  <h1 class="page-title mb-6">논문</h1>

  {
    timelineData.length > 0 && (
      <PublicationTimeline client:load publications={timelineData} />
    )
  }

  {
    sorted.length === 0 ? (
      <p class="text-muted">준비 중입니다.</p>
    ) : (
      <ul class="space-y-3">
        {sorted.map((pub) => (
          <li class="border-b border-default pb-3">
            <p class="font-medium text-primary">{pub.data.title}</p>
            <p class="text-sm text-muted">
              {pub.data.authors.join(', ')} ({pub.data.year})
              {pub.data.journal ? ` · ${pub.data.journal}` : ''}
            </p>
          </li>
        ))}
      </ul>
    )
  }
</BaseLayout>
