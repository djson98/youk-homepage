---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const pubs = await getCollection('publications');
const sorted = [...pubs].sort((a, b) => b.data.year - a.data.year);

const grouped = sorted.reduce<Record<number, typeof sorted>>((acc, pub) => {
  const y = pub.data.year;
  if (!acc[y]) acc[y] = [];
  acc[y].push(pub);
  return acc;
}, {});

const years = Object.keys(grouped)
  .map(Number)
  .sort((a, b) => b - a);
---

<BaseLayout title="Publications">
  <h1 class="page-title mb-6">Publications</h1>

  {
    sorted.length === 0 ? (
      <p class="text-muted">준비 중입니다.</p>
    ) : (
      <>
        <nav
          class="sticky top-16 md:top-20 z-10 -mx-3 md:-mx-8 px-3 md:px-8 py-3 bg-page/90 backdrop-blur border-b border-default mb-10"
          aria-label="연도별 논문 바로가기"
        >
          <ul class="flex flex-wrap gap-2">
            {years.map((y) => (
              <li>
                <a
                  href={`#year-${y}`}
                  class="px-3 py-1 rounded-full text-sm border border-default text-muted hover:text-primary hover:border-primary transition-colors"
                >
                  {y}
                </a>
              </li>
            ))}
          </ul>
        </nav>

        <div class="space-y-16">
          {years.map((year) => (
            <section
              id={`year-${year}`}
              class="grid gap-6 md:grid-cols-[8rem_1fr] md:gap-10 scroll-mt-32"
            >
              <h2 class="text-5xl md:text-6xl font-bold text-primary leading-none tracking-tight">
                {year}
              </h2>
              <ul class="space-y-5">
                {grouped[year].map((pub) => (
                  <li class="border-b border-default pb-4">
                    <p class="font-medium text-primary leading-snug">
                      {pub.data.doi ? (
                        <a
                          href={`https://doi.org/${pub.data.doi}`}
                          target="_blank"
                          rel="noopener"
                          class="hover:underline"
                        >
                          {pub.data.title}
                        </a>
                      ) : (
                        pub.data.title
                      )}
                    </p>
                    <p class="text-sm text-muted mt-1">
                      {pub.data.authors.join(', ')}
                      {pub.data.journal ? ` · ${pub.data.journal}` : ''}
                    </p>
                  </li>
                ))}
              </ul>
            </section>
          ))}
        </div>
      </>
    )
  }
</BaseLayout>
