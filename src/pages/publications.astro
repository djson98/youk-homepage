---
import BaseLayout from '../layouts/BaseLayout.astro';
import YearJumpNav from '../components/YearJumpNav.astro';
import BibtexButton from '../components/islands/BibtexButton.tsx';
import BibtexBulkDownload from '../components/islands/BibtexBulkDownload.tsx';
import { getPublications } from '../lib/sanity';
import type { PublicationData } from '../lib/bibtex';

const sorted = await getPublications();

const grouped = sorted.reduce<Record<number, typeof sorted>>((acc, pub) => {
  const y = pub.data.year;
  if (!acc[y]) acc[y] = [];
  acc[y].push(pub);
  return acc;
}, {});

const years = Object.keys(grouped)
  .map(Number)
  .sort((a, b) => b - a);

/**
 * 원문으로 가는 링크. PMID를 따로 저장하지 않으므로 PubMed는 검색 URL로 보낸다.
 * DOI로 검색하면 해당 논문 한 건으로 바로 떨어지고, DOI가 없으면 제목으로
 * 검색해 결과 목록을 띄운다.
 */
function pubmedUrl(doi: string | undefined, title: string): string {
  const term = doi?.trim() || title;
  return `https://pubmed.ncbi.nlm.nih.gov/?term=${encodeURIComponent(term)}`;
}

function doiUrl(doi: string): string {
  return doi.startsWith('http') ? doi : `https://doi.org/${doi}`;
}

const allBibtexData: PublicationData[] = sorted.map((p) => ({
  title: p.data.title,
  authors: p.data.authors,
  journal: p.data.journal,
  year: p.data.year,
  doi: p.data.doi,
  type: p.data.type,
}));
---

<BaseLayout title="Publications">
  <div class="mb-6 flex flex-wrap items-center justify-between gap-3">
    <h1 class="page-title">Publications</h1>
    {
      sorted.length > 0 && (
        <BibtexBulkDownload
          client:idle
          publications={allBibtexData}
          filename="youk-lab-publications"
        />
      )
    }
  </div>

  {
    sorted.length === 0 ? (
      <p class="text-muted">준비 중입니다.</p>
    ) : (
      <>
        <YearJumpNav years={years} label="연도별 논문 바로가기" />

        <div class="space-y-16">
          {years.map((year) => (
            <section
              id={`year-${year}`}
              class="grid scroll-mt-32 gap-6 md:grid-cols-[8rem_1fr] md:gap-10"
            >
              <h2 class="text-primary text-5xl leading-none font-bold tracking-tight md:text-6xl">
                {year}
              </h2>
              <ul class="space-y-5">
                {grouped[year].map((pub) => (
                  <li class="border-default border-b pb-4">
                    <p class="text-primary leading-snug font-medium">
                      <a
                        href={
                          pub.data.doi
                            ? doiUrl(pub.data.doi)
                            : pubmedUrl(undefined, pub.data.title)
                        }
                        target="_blank"
                        rel="noopener noreferrer"
                        class="hover:underline"
                        title="원문 보기"
                      >
                        {pub.data.title}
                        <span
                          class="text-muted-subtle ml-1 align-middle text-xs"
                          aria-hidden="true"
                        >
                          ↗
                        </span>
                      </a>
                    </p>
                    <p class="text-muted mt-1 text-sm">
                      {pub.data.authors.join(', ')}
                      {pub.data.journal ? ` · ${pub.data.journal}` : ''}
                    </p>
                    <div class="mt-2 flex flex-wrap items-center gap-2">
                      <a
                        href={pubmedUrl(pub.data.doi, pub.data.title)}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="btn-badge"
                      >
                        PubMed ↗
                      </a>
                      {pub.data.doi && (
                        <a
                          href={doiUrl(pub.data.doi)}
                          target="_blank"
                          rel="noopener noreferrer"
                          class="btn-badge"
                        >
                          DOI ↗
                        </a>
                      )}
                      {pub.data.pdf && (
                        <a
                          href={pub.data.pdf}
                          target="_blank"
                          rel="noopener noreferrer"
                          class="btn-badge"
                        >
                          PDF ↗
                        </a>
                      )}
                      <BibtexButton
                        client:idle
                        publication={{
                          title: pub.data.title,
                          authors: pub.data.authors,
                          journal: pub.data.journal,
                          year: pub.data.year,
                          doi: pub.data.doi,
                          type: pub.data.type,
                        }}
                      />
                    </div>
                  </li>
                ))}
              </ul>
            </section>
          ))}
        </div>
      </>
    )
  }
</BaseLayout>
