---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const albums = await getCollection('gallery');
const sorted = [...albums].sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime()
);

const dateFmt = new Intl.DateTimeFormat('ko-KR', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

const normalize = (img: string | { src: string; caption?: string }) =>
  typeof img === 'string' ? { src: img, caption: undefined } : img;

const PLACEHOLDER_HEIGHTS = [
  'h-72', 'h-96', 'h-80', 'h-[28rem]', 'h-64', 'h-[32rem]',
  'h-80', 'h-[26rem]', 'h-72', 'h-96', 'h-80', 'h-[30rem]',
];
---

<BaseLayout title="Gallery">
  <h1 class="page-title mb-8">Gallery</h1>

  {
    sorted.length === 0 ? (
      <div
        class="columns-1 sm:columns-2 lg:columns-3 gap-4 space-y-4"
        aria-label="갤러리 placeholder"
      >
        {PLACEHOLDER_HEIGHTS.map((h) => (
          <div
            class:list={[
              'break-inside-avoid bg-surface-muted border border-default rounded',
              h,
            ]}
            aria-hidden="true"
          />
        ))}
      </div>
    ) : (
      <div class="space-y-12">
        {sorted.map((album) => (
          <section>
            <header class="mb-4">
              <p class="text-sm text-muted">
                {dateFmt.format(album.data.date)}
              </p>
              <h2 class="text-xl font-semibold text-primary mt-1">
                {album.data.title}
              </h2>
              {album.data.description && (
                <p class="text-sm text-muted mt-2">{album.data.description}</p>
              )}
            </header>
            <div class="columns-1 sm:columns-2 lg:columns-3 gap-4 space-y-4">
              {album.data.images.map((raw) => {
                const img = normalize(raw);
                return (
                  <figure class="break-inside-avoid">
                    <img
                      src={img.src}
                      alt={img.caption ?? album.data.title}
                      class="w-full h-auto rounded border border-default"
                      loading="lazy"
                    />
                    {img.caption && (
                      <figcaption class="text-xs text-muted mt-1">
                        {img.caption}
                      </figcaption>
                    )}
                  </figure>
                );
              })}
            </div>
          </section>
        ))}
      </div>
    )
  }
</BaseLayout>
