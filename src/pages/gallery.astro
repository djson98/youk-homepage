---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getGallery } from '../lib/sanity';

const sorted = await getGallery();

const dateFmt = new Intl.DateTimeFormat('ko-KR', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

const PLACEHOLDER_HEIGHTS = [
  'h-72',
  'h-96',
  'h-80',
  'h-[28rem]',
  'h-64',
  'h-[32rem]',
  'h-80',
  'h-[26rem]',
  'h-72',
  'h-96',
  'h-80',
  'h-[30rem]',
];
---

<BaseLayout title="Gallery">
  <h1 class="page-title mb-8">Gallery</h1>

  {
    sorted.length === 0 ? (
      <div
        class="columns-1 gap-4 space-y-4 sm:columns-2 lg:columns-3"
        aria-label="갤러리 placeholder"
      >
        {PLACEHOLDER_HEIGHTS.map((h) => (
          <div
            class:list={[
              'bg-surface-muted border-default break-inside-avoid rounded border',
              h,
            ]}
            aria-hidden="true"
          />
        ))}
      </div>
    ) : (
      <div class="space-y-12">
        {sorted.map((album) => (
          <section>
            <header class="mb-4">
              <p class="text-muted text-sm">
                {dateFmt.format(album.data.date)}
              </p>
              <h2 class="text-primary mt-1 text-xl font-semibold">
                {album.data.title}
              </h2>
              {album.data.description && (
                <p class="text-muted mt-2 text-sm">{album.data.description}</p>
              )}
            </header>
            <div class="columns-1 gap-4 space-y-4 sm:columns-2 lg:columns-3">
              {album.data.images.map((img) => (
                <figure class="break-inside-avoid">
                  <img
                    src={img.src}
                    alt={img.caption ?? album.data.title}
                    class="border-default h-auto w-full rounded border"
                    loading="lazy"
                  />
                  {img.caption && (
                    <figcaption class="text-muted mt-1 text-xs">
                      {img.caption}
                    </figcaption>
                  )}
                </figure>
              ))}
            </div>
          </section>
        ))}
      </div>
    )
  }
</BaseLayout>
