---
// Bio block — Astro presentational version of the Gatsby `bio.tsx` component.
// Accepts professor/author info as props. Photo is a public-relative path
// (e.g. `/images/profile-pic.png`) or an absolute URL.

export interface Props {
  name: string;
  title?: string;
  affiliation?: string;
  email?: string;
  photo?: string;
  bio?: string;
}

const { name, title, affiliation, email, photo, bio } = Astro.props;
---

<div class="bio mb-12 flex items-start gap-4">
  {
    photo && (
      <img
        src={photo}
        alt={`${name} profile photo`}
        width="96"
        height="96"
        class="bio-avatar h-24 w-24 flex-shrink-0 rounded-full object-cover"
      />
    )
  }
  <div class="min-w-0 flex-1">
    <h2 class="text-primary mb-1 text-lg font-semibold md:text-xl">{name}</h2>
    {title && <p class="text-muted mb-1 text-sm">{title}</p>}
    {affiliation && <p class="text-muted mb-1 text-sm">{affiliation}</p>}
    {
      email && (
        <p class="text-muted mb-2 text-sm">
          <a href={`mailto:${email}`} class="hover:text-accent">
            {email}
          </a>
        </p>
      )
    }
    {
      bio && (
        <p class="text-muted text-sm leading-relaxed md:text-base">{bio}</p>
      )
    }
  </div>
</div>
