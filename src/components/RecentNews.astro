---
import { getNews } from '../lib/sanity';

interface Props {
  limit?: number;
  href?: string;
}

const { limit = 4, href = '/news' } = Astro.props;

const all = await getNews();
const recent = all.slice(0, limit);

const dateFmt = new Intl.DateTimeFormat('ko-KR', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<section class="space-y-4">
  <header class="flex items-baseline justify-between">
    <h2 class="text-primary text-lg font-semibold">News</h2>
    <a href={href} class="text-muted text-sm hover:underline"> 모두 보기 → </a>
  </header>

  {
    recent.length === 0 ? (
      <p class="text-muted">준비 중입니다.</p>
    ) : (
      <ul class="space-y-3">
        {recent.map((n) => (
          <li class="border-default border-b pb-3">
            <p class="text-muted text-xs">{dateFmt.format(n.data.date)}</p>
            <p class="text-primary mt-1 leading-snug font-medium">
              {n.data.link ? (
                <a
                  href={n.data.link}
                  target="_blank"
                  rel="noopener"
                  class="hover:underline"
                >
                  {n.data.title}
                </a>
              ) : (
                n.data.title
              )}
            </p>
            {n.data.summary && (
              <p class="text-muted mt-1 text-sm">{n.data.summary}</p>
            )}
          </li>
        ))}
      </ul>
    )
  }
</section>
