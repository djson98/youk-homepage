---
// Recent Research highlights — 그림만 보여주는 3-column grid.
// 양식 도착 전 placeholder. 추후 content collection으로 전환 예정.

interface Highlight {
  title?: string;
  image?: string;
  link?: string;
}

const highlights: Highlight[] = [
  { title: '하이라이트 1' },
  { title: '하이라이트 2' },
  { title: '하이라이트 3' },
];
---

<section class="space-y-6">
  <header class="flex items-baseline justify-between">
    <h2 class="text-primary text-lg font-semibold">Recent Research</h2>
    <a href="/research" class="text-muted text-sm hover:underline">
      모두 보기 →
    </a>
  </header>

  <ul class="grid grid-cols-2 gap-3 sm:gap-6 lg:grid-cols-3">
    {
      highlights.map((h) => (
        <li>
          <a
            href={h.link ?? '/research'}
            class="bg-surface-muted border-default block aspect-[4/3] overflow-hidden rounded border transition-opacity hover:opacity-90"
            aria-label={h.title}
          >
            {h.image ? (
              <img
                src={h.image}
                alt={h.title ?? ''}
                class="h-full w-full object-cover"
              />
            ) : (
              <div class="flex h-full w-full items-center justify-center">
                <span class="text-muted-subtle text-xs">이미지 자리</span>
              </div>
            )}
          </a>
        </li>
      ))
    }
  </ul>
</section>
