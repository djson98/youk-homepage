---
// Recent Research highlights — 그림만 보여주는 3-column grid.
// 양식 도착 전 placeholder. 추후 content collection으로 전환 예정.

interface Highlight {
  title?: string;
  image?: string;
  link?: string;
}

const highlights: Highlight[] = [
  { title: '하이라이트 1' },
  { title: '하이라이트 2' },
  { title: '하이라이트 3' },
];
---

<section class="space-y-6">
  <header class="flex items-baseline justify-between">
    <h2 class="text-lg font-semibold text-primary">Recent Research</h2>
    <a href="/research" class="text-sm text-muted hover:underline">
      모두 보기 →
    </a>
  </header>

  <ul class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
    {
      highlights.map((h) => (
        <li>
          <a
            href={h.link ?? '/research'}
            class="block aspect-[4/3] bg-surface-muted border border-default rounded overflow-hidden hover:opacity-90 transition-opacity"
            aria-label={h.title}
          >
            {h.image ? (
              <img
                src={h.image}
                alt={h.title ?? ''}
                class="w-full h-full object-cover"
              />
            ) : (
              <div class="w-full h-full flex items-center justify-center">
                <span class="text-xs text-muted-subtle">이미지 자리</span>
              </div>
            )}
          </a>
        </li>
      ))
    }
  </ul>
</section>
