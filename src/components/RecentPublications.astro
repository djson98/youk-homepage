---
import { getPublications } from '../lib/sanity';

interface Props {
  limit?: number;
  href?: string;
}

const { limit = 5, href = '/publications' } = Astro.props;

const all = await getPublications();
const recent = all.slice(0, limit);
---

<section class="space-y-4">
  <header class="flex items-baseline justify-between">
    <h2 class="text-primary text-lg font-semibold">Recent Publications</h2>
    <a href={href} class="text-muted text-sm hover:underline"> 모두 보기 → </a>
  </header>

  {
    recent.length === 0 ? (
      <p class="text-muted">준비 중입니다.</p>
    ) : (
      <ul class="space-y-3">
        {recent.map((pub) => (
          <li class="border-default border-b pb-3">
            <p class="text-primary leading-snug font-medium">
              {pub.data.doi ? (
                <a
                  href={`https://doi.org/${pub.data.doi}`}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="hover:underline"
                >
                  {pub.data.title}
                </a>
              ) : (
                pub.data.title
              )}
            </p>
            <p class="text-muted mt-1 text-sm">
              {pub.data.authors.slice(0, 4).join(', ')}
              {pub.data.authors.length > 4 ? ' 외' : ''} ({pub.data.year})
              {pub.data.journal ? ` · ${pub.data.journal}` : ''}
            </p>
          </li>
        ))}
      </ul>
    )
  }
</section>
